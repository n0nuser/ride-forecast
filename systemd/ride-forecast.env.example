# Copy to /etc/ride-forecast.env and run: sudo chmod 600 /etc/ride-forecast.env
# One KEY=value per line. No spaces around "=" and no comment after a value (systemd keeps it as part of the value).

# The bot answers only this chat and pushes the nightly forecast to it.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Defaults. /place and /trips in the chat override them and are remembered.
RIDE_PLACE=
RIDE_COUNTRY=
# Trips are yours: there are none built in. Format: NAME HH:MM-HH:MM [days];NAME ...
# For example: RIDE_TRIPS=work 08:00-09:00 mon-fri;home 17:30-18:30 mon-fri;out 20:00-22:00
RIDE_TRIPS=
# When the nightly report goes out, local time of the place.
RIDE_PUSH_TIME=21:00

# Optional, only for ride.py run by hand or from cron.
WEBHOOK_URL=
