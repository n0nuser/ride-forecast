[Unit]
Description=Tomorrow's motorbike forecast
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/ride-forecast.env
ExecStart=/usr/bin/python3 /opt/ride-forecast/ride.py
TimeoutStartSec=300
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
